# DigiBook Environment Variables
# Copy to .env and configure for your environment

# Database Configuration (Remote MySQL Database)
DB_HOST=db.aerochrome.in
DB_PORT=3306
DB_USER=u672633758_digibook
DB_PASSWORD=DigiBook@8520
DB_NAME=u672633758_digibook
DB_POOL_SIZE=3

# Flask Web Application
FLASK_SECRET_KEY=change-this-to-a-secure-random-64-character-key
FLASK_ENV=development
DIGIBOOK_ENV=development

# Hardware & Simulation Settings
# Set to 1 to force simulation mode (mouse = LED pen, keyboard = RFID)
# Defaults to 1 on PC / Mac / Windows; defaults to 0 on Raspberry Pi
DIGIBOOK_SIMULATE=0

# Camera & Detection Settings
CAMERA_BACKEND=usb
CAMERA_DEVICE_INDEX=0
LED_TYPE=green
LED_PEN_HAS_BUTTON=1

# Security & Sessions
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_HOURS_LOCAL=2
SESSION_TIMEOUT_HOURS_WEB=24
