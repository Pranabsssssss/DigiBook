[Unit]
Description=DigiBook Web Application (Gunicorn)
After=network.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=book
Group=book
WorkingDirectory=/home/book/Desktop/DigiBook
Environment="PATH=/home/book/Desktop/DigiBook/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/book/Desktop/DigiBook/.env
ExecStart=/home/book/Desktop/DigiBook/venv/bin/gunicorn -c deployment/gunicorn.conf.py "webapp.app:create_app()"
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
