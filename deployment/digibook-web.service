[Unit]
Description=DigiBook Web Application (Gunicorn)
After=network.target mariadb.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=book
Group=book
WorkingDirectory=/home/book/Desktop/DigiBook
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/home/book/Desktop/DigiBook/.env
ExecStart=/usr/bin/gunicorn -c deployment/gunicorn.conf.py "webapp.app:create_app()"
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
