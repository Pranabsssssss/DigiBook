[Unit]
Description=DigiBook Local RFID Whiteboard (Pygame & Camera)
After=network.target digibook-web.service
Wants=digibook-web.service

[Service]
Type=simple
User=book
Group=book
WorkingDirectory=/home/book/Desktop/DigiBook
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/book/.Xauthority"
Environment="PATH=/home/book/Desktop/DigiBook/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/book/Desktop/DigiBook/.env
ExecStart=/home/book/Desktop/DigiBook/venv/bin/python run.py --camera usb
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
