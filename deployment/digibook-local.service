[Unit]
Description=DigiBook Local RFID Whiteboard (Pygame & Camera)
After=network.target digibook-web.service
Wants=digibook-web.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/DigiBook
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/pi/.Xauthority"
Environment="PATH=/home/pi/DigiBook/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/pi/DigiBook/.env
ExecStart=/home/pi/DigiBook/venv/bin/python run.py --camera usb
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=graphical.target
